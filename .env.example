# ─────────────────────────────────────────────────────────────
#  Telegram Music Bot — environment variables
#  Copy this file to .env for local runs, or paste these keys into
#  Render → Environment. NEVER commit a filled-in .env to GitHub.
# ─────────────────────────────────────────────────────────────

# ── Branding ─────────────────────────────────────────────────
# The public name of your bot. This single value is used by every
# card, menu, button and log line in the whole codebase.
BOT_NAME=Music Bot
BOT_TAGLINE=High quality music, zero lag 🎧

# ── Telegram API (from my.telegram.org) ──────────────────────
API_ID=
API_HASH=

# Bot token (from @BotFather)
BOT_TOKEN=

# Your bot's username, without the @
BOT_USERNAME=

# Pyrogram string session of the assistant/userbot account.
# Generate with: python3 genstring.py


# ── Database ─────────────────────────────────────────────────
# MongoDB Atlas connection string (mongodb+srv://...)
MONGO_DB_URI=

# ── Owner ────────────────────────────────────────────────────
# Your Telegram numeric user ID
OWNER_ID=
# Alias shown on cards — not your real name
OWNER_NAME=
# Private group ID for error logs (e.g. -1001234567890)
LOG_GROUP_ID=
# Optional: separate archive channel; blank means LOG_GROUP_ID is used.
MUSIC_ARCHIVE_CHANNEL_ID=

# ── YouTube ──────────────────────────────────────────────────
# YouTube cookies are added securely from /panel → Add Cookies and stored in MongoDB.
# Optional residential HTTP/SOCKS proxy used only for YouTube.
# Cookies + a residential proxy are the most reliable cloud setup.
YTDLP_PROXY=
DOWNLOAD_DEADLINE=35
YT_BOTWALL_MAX_RUNGS=8
YT_COOKIE_DISTRUST_SECONDS=300
# Runtime cookie copies are temporary files; cookie data is persisted in MongoDB.
YT_COOKIE_COPY_TTL_SECONDS=86400
YT_RETRIES=1
YT_FRAGMENT_RETRIES=2
YT_EXTRACTOR_RETRIES=1
YT_CONCURRENT_FRAGMENTS=2
# Optional YouTube Data API v3 key(s), comma separated for rotation.
YOUTUBE_API_KEY=

# ── Lyrics ───────────────────────────────────────────────────
# Genius API token (from genius.com/api-clients)
GENIUS_API_TOKEN=

# ── Playback behaviour ───────────────────────────────────────
AUTOPLAY=true
VIDEO_QUALITY=480p
DIRECT_STREAM=true
# Heroku 512 MB: audio downloads are single-path; VPlay/video direct path stays enabled.
AUDIO_DIRECT_STREAM=false
DIRECT_VIDEO_STREAM=true
VIDEO_FALLBACK_MAX_SECONDS=1800
PLAY_PROBE_TIMEOUT=7
PLAY_STARTUP_DEADLINE=20
EARLY_AUDIO_HANDOFF=false
# Lean profile: load only the music handlers.
MUSIC_ONLY_MODE=false
PLAYBACK_RECOVERY=false
MONGO_GRIDFS_CACHE=false

# ── Optional: persist the /setpic start image to a GitHub repo ─
# Leave empty to disable. Needs a token with repo write access.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_REPO_USERNAME=

# ── Optional: source-code button URL ─────────────────────────
# Leave empty to keep this build private.
SOURCE_CODE_URL=

# ── Performance / memory ─────────────────────────────────────
MEMORY_LIMIT_MB=512
BOT_WORKERS=2
ASSISTANT_WORKERS=1
BOT_TRANSMISSIONS=1
ASSISTANT_TRANSMISSIONS=1
MAX_CONCURRENT_DOWNLOADS=1
PREFETCH_ENABLED=false
ARCHIVE_REMOTE_PLAY=true
TG_PROXY_CACHE_MB=16
TG_PROXY_CACHE_CHUNKS=8
TG_PROXY_FILE_SESSIONS=1
TG_PROXY_CONCURRENCY=2
SONG_CACHE_MB=32
YTDL_WORKERS=2
IO_WORKERS=1
BGUTIL_STARTUP_WARMUP=false
STARTUP_WARMUPS=false
MEM_SOFT_LIMIT_MB=260
MEM_CHECK_SECONDS=3

# ── Playback timing knobs (leave at defaults unless you know why) ─
INNERTUBE_HEADSTART=0.35
FAST_RESOLVE_TIMEOUT=1.5
RESOLVE_TIMEOUT=3.5
REMOTE_CHECK_TIMEOUT=2.5
REMOTE_CHECK_CLOUD_BUDGET=0.9
FFPROBE_REMOTE_TIMEOUT=4
LOCAL_PLAY_TIMEOUT=18
CONTROL_RPC_TIMEOUT=5
